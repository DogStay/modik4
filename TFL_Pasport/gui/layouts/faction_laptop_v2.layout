  ImageWidgetClass ScreenBase { ignorepointer 1 color 0.0392 0.0471 0.0314 1 position 0 0 size 1 1 priority 89 imageTexture "TFL_Pasport/gui/textures/pass_white.edds" mode blend "src alpha" 1 "stretch mode" stretch_w_h }
