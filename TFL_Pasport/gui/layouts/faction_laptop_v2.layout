// faction_laptop_v2.layout — rebuilt from scratch for the TFL Interface Kit
// design pack. This is the in-game leader terminal (TFLFactionLaptopMenu.c),
// not VPP Admin. Its СОСТАВ / РОЛИ tabs reuse the exact same Widget Names as
// faction_admin_v2.layout's MembersPanel/RolesPanel (the kit renders both
// contexts from one shared component), and its ЗАХВАТ ТЕРРИТОРИЙ tab reuses
// the same leader-map markup as territory_leader_v2.layout.
WindowWidgetClass Root
{
 visible 1 position 0 0 size 1 1 priority 101
