// TFL_RewardContentRow.layout — redesigned per TFL Interface Kit. One item in
// a reward preset's content list: RowName + RowMeta (classname) + RowQty +
// RewardContentRemoveButton.
PanelWidgetClass Row {
 visible 1 color 0 0 0 0 position 0 0 size 1 0.24 priority 210
 {
  TextWidgetClass RowName { ignorepointer 1 position 0.03 0.1 size 0.5 0.4 priority 214 text "" font "TFL_Pasport/gui/fonts/IBMPlexMonio-Regular" "text color" 0.9020 0.8941 0.8235 1 text_proportion 0.5 }
  TextWidgetClass RowMeta { ignorepointer 1 position 0.03 0.52 size 0.5 0.34 priority 214 text "" font "TFL_Pasport/gui/fonts/IBMPlexMonio-Regular" "text color" 0.4980 0.4941 0.4235 1 text_proportion 0.42 }
  TextWidgetClass RowQty { ignorepointer 1 position 0.55 0.1 size 0.14 0.8 priority 214 text "" font "TFL_Pasport/gui/fonts/IBMPlexMonio-Regular" "text color" 0.6588 0.7255 0.4471 1 text_proportion 0.5 "text valign" center }
  ButtonWidgetClass RowBtn { color 0 0 0 0 position 0 0 size 0.69 1 priority 212 text "" }
  ButtonWidgetClass RewardContentRemoveButton { color 0.1137 0.0745 0.0627 1 position 0.71 0.14 size 0.27 0.72 priority 214 text "УДАЛИТЬ" font "TFL_Pasport/gui/fonts/IBMPlexMonio-Regular" "text color" 0.7529 0.5412 0.4863 1 text_proportion 0.42 }
 }
}
