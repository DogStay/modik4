  TextWidgetClass RequestTitle { ignorepointer 1 position 0.045 0.065 size 0.8 0.05 priority 214 text "СОВМЕСТНАЯ АТАКА" font "TFL_Pasport/gui/fonts/IBMPlexMonio-Regular" "text color" 0.9020 0.8941 0.8235 1 text_proportion 0.5 }
  ButtonWidgetClass RequestClose { color 0.0784 0.0902 0.0588 1 position 0.89 0.03 size 0.08 0.04 priority 215 text "X" font "TFL_Pasport/gui/fonts/IBMPlexMonio-Regular" "text color" 0.6588 0.7255 0.4471 1 text_proportion 0.6 }

  TextWidgetClass RequestFactionLabel { ignorepointer 1 position 0.045 0.16 size 0.4 0.03 priority 214 text "ФРАКЦИЯ" font "TFL_Pasport/gui/fonts/IBMPlexMonio-Regular" "text color" 0.4980 0.4941 0.4235 1 text_proportion 0.36 }
  TextWidgetClass TerritoryRequestFaction { ignorepointer 1 position 0.045 0.195 size 0.9 0.04 priority 214 text "" font "TFL_Pasport/gui/fonts/IBMPlexMonio-Regular" "text color" 0.9020 0.8941 0.8235 1 text_proportion 0.46 }
