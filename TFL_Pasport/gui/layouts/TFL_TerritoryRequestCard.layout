  ButtonWidgetClass TerritoryRequestAccept { color 0.1647 0.2078 0.1255 1 position 0.045 0.80 size 0.42 0.14 priority 220 text "ПРИНЯТЬ" font "TFL_Pasport/gui/fonts/IBMPlexMonio-Regular" "text color" 0.8588 0.9020 0.7059 1 text_proportion 0.42 }
