  TextWidgetClass RowName { ignorepointer 1 position 0.04 0.1 size 0.92 0.44 priority 214 text "" font "TFL_Pasport/gui/fonts/IBMPlexMonio-Regular" "text color" 0.9020 0.8941 0.8235 1 text_proportion 0.5 }
  TextWidgetClass RowMeta { ignorepointer 1 position 0.04 0.56 size 0.92 0.38 priority 214 text "" font "TFL_Pasport/gui/fonts/IBMPlexMonio-Regular" "text color" 0.4353 0.4314 0.3686 1 text_proportion 0.4 }
 }
