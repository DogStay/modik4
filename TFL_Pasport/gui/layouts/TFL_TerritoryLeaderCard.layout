// TFL_TerritoryLeaderCard.layout — rebuilt from scratch. Compact territory
// intel card, created dynamically and positioned next to the clicked marker
// by script (TFLTerritoryLeaderMenu.c / TFLFactionLaptopMenu.c).
PanelWidgetClass TerritoryCard
{
 visible 0 color 0.0784 0.0902 0.0588 1 position 0 0 size 1 1 priority 200
 {
  ImageWidgetClass CardAccent { ignorepointer 1 color 0.6588 0.7255 0.4471 1 position 0 0 size 0.008 1 priority 201 imageTexture "TFL_Pasport/gui/textures/pass_white.edds" mode blend "src alpha" 1 "stretch mode" stretch_w_h }
