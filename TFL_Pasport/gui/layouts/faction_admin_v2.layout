// faction_admin_v2.layout
// TFL // FACTION CONTROL — VPP admin shell. Built fresh from the TFL Interface
// Kit design pack (2026-08-18): header, one tab bar, one content host with six
// panels (ФРАКЦИЯ / СОСТАВ / РОЛИ / ЗВАНИЯ / ЛИЦЕНЗИИ / ТЕРРИТОРИИ). Only one
// panel is visible at a time. Every Widget Name below matches the design
// pack's data-widget attributes exactly; nothing here reuses the pre-redesign
// faction_admin.layout.
WindowWidgetClass Root
{
